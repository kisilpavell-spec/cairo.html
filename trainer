 "ipa": "/ˌtel ˈɔːf/", "ru": "يوبّخ", "en": "My boss told me off.", "er": ""}, {"v": "tip off", "ipa": "/ˌtɪp ˈɔːf/", "ru": "يبلّغ سراً، ينبّه", "en": "Someone tipped off the police.", "er": ""}, {"v": "pass away", "ipa": "/ˌpæs əˈweɪ/", "ru": "يتوفى", "en": "His grandmother passed away last year.", "er": ""}, {"v": "bug out", "ipa": "/ˌbʌɡ ˈaʊt/", "ru": "يفقد أعصابه ويهرب", "en": "He bugged out and left town.", "er": ""}, {"v": "suck up to", "ipa": "/ˈsʌk ʌp tuː/", "ru": "يتملّق", "en": "He’s always sucking up to the boss.", "er": ""}, {"v": "butt in", "ipa": "/ˌbʌt ˈɪn/", "ru": "يتطفّل على الحديث", "en": "Don’t butt in, this is private.", "er": ""}, {"v": "chicken out", "ipa": "/ˌtʃɪkɪn ˈaʊt/", "ru": "يجبن، يتراجع خوفاً", "en": "He chickened out at the last second.", "er": ""}, {"v": "ditch (ditch out)", "ipa": "/ˈdɪtʃ/", "ru": "يتخلى عن", "en": "She ditched me at the party.", "er": ""}, {"v": "ghost", "ipa": "/ɡoʊst/", "ru": "يختفي فجأة بلا تفسير", "en": "He ghosted me after two dates.", "er": ""}, {"v": "bail on", "ipa": "/ˈbeɪl ɑːn/", "ru": "يخذل، يتخلف عن موعد", "en": "He bailed on me last minute.", "er": ""}, {"v": "dumb down", "ipa": "/ˌdʌm ˈdaʊn/", "ru": "يبسّط بإفراط", "en": "Don’t dumb it down for me.", "er": ""}];
const PART=["up","out","on","off","down","over","in","around","away","by","apart","behind","back","about"];
let mode="cards",known=new Set(),score=0,total=0,streak=0,cur=null,flip=false;
try{known=new Set(JSON.parse(localStorage.getItem("pv_known_ar")||"[]"))}catch(e){}
const save=()=>{try{localStorage.setItem("pv_known_ar",JSON.stringify([...known]))}catch(e){}};
const $=id=>document.getElementById(id);
const rnd=a=>a[Math.floor(Math.random()*a.length)];
const shuf=a=>a.map(x=>[Math.random(),x]).sort((p,q)=>p[0]-q[0]).map(p=>p[1]);
const esc=s=>String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;");
document.querySelectorAll(".tabs button").forEach(b=>b.onclick=()=>{
 document.querySelectorAll(".tabs button").forEach(x=>x.classList.remove("on"));b.classList.add("on");
 mode=b.dataset.m;score=0;total=0;streak=0;next()});
function bar(){ $("bar").innerHTML= mode==="cards" ? `<span>Learned: ${known.size} of ${D.length}</span><span></span>` : `<span>Correct: ${score} of ${total}</span><span>Streak: ${streak}</span>`}
function next(){bar();({cards:cards,tr:tr,gap:gap})[mode]()}
function cards(){
 const pool=D.filter((d,i)=>!known.has(i));
 if(!pool.length){$("main").innerHTML='<div class="card"><div class="v">All learned 🎉</div><div class="row"><button class="btn" id="rs">Start over</button></div></div>';$("rs").onclick=()=>{known.clear();save();next()};return}
 cur=rnd(pool);flip=false;drawCard();
}
function drawCard(){
 const d=cur;
 $("main").innerHTML=`<div class="card" id="c" style="cursor:pointer">${flip?
 `<div class="ru" dir="auto">${esc(d.ru)}</div><div class="v" style="font-size:22px;margin-top:8px">${esc(d.v)}</div><div class="ipa">${esc(d.ipa)}</div><div class="ex">${esc(d.en)}</div><div class="exr">${esc(d.er)}</div>`:
 `<div class="v">${esc(d.v)}</div><div class="ipa">${esc(d.ipa)}</div><div class="hint">Tap to see the meaning</div>`}</div>
 ${flip?'<div class="row"><button class="btn no" id="n">Review again</button><button class="btn ok" id="k">Got it</button></div>':''}`;
 $("c").onclick=()=>{if(!flip){flip=true;drawCard()}};
 if(flip){$("n").onclick=cards;$("k").onclick=()=>{known.add(D.indexOf(cur));save();next()}}
}
function choice(q,ans,opts,after){
 $("main").innerHTML=`<div class="card">${q}</div><div class="opts" id="o"></div>`;
 shuf(opts).forEach(t=>{const b=document.createElement("button");b.className="opt";b.dir="auto";b.textContent=t;
  b.onclick=()=>{if(b.dataset.d)return;total++;const ok=t===ans;score+=ok;streak=ok?streak+1:0;
   [...$("o").children].forEach(x=>{x.dataset.d=1;if(x.textContent===ans)x.classList.add("good")});if(!ok)b.classList.add("wrong");
   bar();after(ok)};$("o").appendChild(b)});
}
function nextBtn(){const b=document.createElement("button");b.className="btn";b.style.marginTop="4px";b.textContent="Next →";b.onclick=next;$("o").appendChild(b)}
function tr(){
 cur=rnd(D);const wrong=shuf(D.filter(d=>d.ru!==cur.ru)).slice(0,3).map(d=>d.ru);
 choice(`<div class="v">${esc(cur.v)}</div><div class="ipa">${esc(cur.ipa)}</div><div class="hint">What does it mean?</div>`,cur.ru,[cur.ru,...wrong],()=>nextBtn());
}
function gap(){
 let it=null,re=null;
 for(let i=0;i<60&&!it;i++){const d=rnd(D);const w=d.v.replace(/\s*\(.*\)/,"").split(" ");
  if(w.length<2)continue;const p=w[1];re=new RegExp("\\b"+p+"\\b","i");if(re.test(d.en)){it=d;it.p=p}}
 cur=it;const s=esc(cur.en).replace(re,'<span class="gap">&nbsp;&nbsp;&nbsp;&nbsp;</span>');
 const wrong=shuf(PART.filter(x=>x!==cur.p)).slice(0,3);
 choice(`<div class="q">${s}</div><div class="exr" style="margin-top:8px">${esc(cur.er)}</div><div class="hint">${esc(cur.v.split(" ")[0])} … ? Choose the particle</div>`,cur.p,[cur.p,...wrong],()=>nextBtn());
}
next();
